# Chatwoot MCP server settings. Copy to .env and fill in. Never commit a real .env.

# --- Required in every mode ---------------------------------------------------------------------
# Where Chatwoot is, with no path. Hosted next to Chatwoot, use its internal address.
CHATWOOT_URL=https://chatwoot.example.com
# The one Chatwoot account the tools work in. Tools never take an account id.
CHATWOOT_ACCOUNT_ID=1

# --- stdio: `chatwoot-mcp stdio` ----------------------------------------------------------------
# Your own key: Chatwoot, Profile Settings, Access Token. It acts with your Chatwoot role.
CHATWOOT_HTTP_TOKEN=

# --- http: `chatwoot-mcp http` ------------------------------------------------------------------
# Leave CHATWOOT_HTTP_TOKEN empty: each caller sends their own key as X-Chatwoot-Token to /http/api-key/mcp.
# Setting it serves /mcp as that key's owner for anyone who can reach the port, and only with this opt-in:
# CHATWOOT_HTTP_SHARED_TOKEN_ROUTE=false
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8215

# --- What exists (all optional) -----------------------------------------------------------------
# true registers no tool that changes anything.
# CHATWOOT_READ_ONLY=false
# One switch per tool module. Replies and macros reach the customer, so they are off by default.
# CHATWOOT_ENABLE_REFERENCE=true
# CHATWOOT_ENABLE_CONVERSATIONS=true
# CHATWOOT_ENABLE_MESSAGES=true
# CHATWOOT_ENABLE_CONTACTS=true
# CHATWOOT_ENABLE_LABELS=true
# CHATWOOT_ENABLE_HELP_CENTER=true
# CHATWOOT_ENABLE_REPORTS=true
# CHATWOOT_ENABLE_REPLIES=false
# CHATWOOT_ENABLE_MACROS=false
# Hide tools the key's role cannot use (reports for agents).
# CHATWOOT_FILTER_TOOLS_BY_ROLE=false

# --- Limits (all optional) ----------------------------------------------------------------------
# CHATWOOT_PUBLIC_URL=            # base for links in results; defaults to CHATWOOT_URL
# CHATWOOT_CONFIRM_TTL_SECONDS=600
# CHATWOOT_MAX_ITEMS=25
# CHATWOOT_MAX_TEXT_CHARS=2000
# CHATWOOT_TIMEOUT_SECONDS=30
# CHATWOOT_CONNECT_TIMEOUT_SECONDS=10
# MCP_LOG_LEVEL=INFO

# --- Platform mode (Moneta SSO) -----------------------------------------------------------------
# Setting COGNITO_USER_POOL_ID makes `chatwoot-mcp http` run platform mode. See docs/platform-mode.md.
# COGNITO_USER_POOL_ID=
# COGNITO_AWS_REGION=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# MCP_BASE_URL=https://chat-mcp.foss.example.com
# CHATWOOT_INTERNAL_BASE_URL=http://chatwoot-web:3000
# DEFAULT_EMAIL_DOMAIN=example.com
# Same value as the platform's; true refuses users who have not verified an email yet
# LAUNCHPAD_EMAIL_CAPTURE=false
# Added to the built-in list of common MCP clients (localhost, Cursor, VS Code, Claude.ai, ChatGPT, Gemini, Askii)
# MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://another-client.example/oauth/callback
# On the Moneta bundle use DB 3: 2, 5-14 are claimed by other services (launchpad-api src/config.py)
# MCP_OAUTH_STORAGE_URL=valkey://valkey:6379/3
