# Chatwoot MCP server settings. Copy to .env and fill in. Never commit a real .env.

# --- Required in every mode ---------------------------------------------------------------------
# Where Chatwoot is, with no path. Hosted next to Chatwoot on the Moneta network, use its internal address.
CHATWOOT_BASE_URL=https://chatwoot.example.com
# The one Chatwoot account the tools work in. Tools never take an account id, so the assistant
# cannot move to another account.
CHATWOOT_ACCOUNT_ID=1

# --- Laptop mode: `chatwoot-mcp stdio` ----------------------------------------------------------
# Your own key: Chatwoot, Profile Settings, Access Token. It acts with your Chatwoot role.
CHATWOOT_API_TOKEN=

# --- Hosted mode: `chatwoot-mcp http` -----------------------------------------------------------
# No key is set here. Each caller sends their own as the X-Chatwoot-Token header to
# /http/api-key/mcp. Any X-Auth-Request-* header they send is dropped.
# Address to listen on. Docker sets 0.0.0.0; on a laptop leave it as 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8214

# --- Safety switches (all optional) ---------------------------------------------------------------
# The two write tools (add_private_note, add_conversation_labels) do not exist until this is true.
# CHATWOOT_MCP_ENABLE_WRITES=false
# How many items a list returns at most, and how many characters of message text are kept.
# CHATWOOT_MCP_MAX_ITEMS=25
# CHATWOOT_MCP_MAX_TEXT_CHARS=2000
# Seconds to wait for Chatwoot (more than 0, at most 600).
# CHATWOOT_MCP_TIMEOUT_SECONDS=30
# DEBUG, INFO, WARNING or ERROR. Logs go to stderr.
# MCP_LOG_LEVEL=INFO
